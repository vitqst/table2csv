{
  "manifest_version": 3,
  "name": "Table to CSV Exporter",
  "version": "1.0",
  "description": "A Chrome extension to convert HTML tables to CSV.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "dist/src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
